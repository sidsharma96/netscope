ed_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W14\", \"family\": \"W\", \"name\": \"reject-403\", \"method\": \"GET\", \"status\": 403, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W15\", \"family\": \"W\", \"name\": \"reject-404\", \"method\": \"GET\", \"status\": 404, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W16\", \"family\": \"W\", \"name\": \"missing-accept\", \"method\": \"GET\", \"status\": 101, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W17\", \"family\": \"W\", \"name\": \"bad-digest\", \"method\": \"GET\", \"status\": 101, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W18\", \"family\": \"W\", \"name\": \"missing-upgrade\", \"method\": \"GET\", \"status\": 101, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W19\", \"family\": \"W\", \"name\": \"unoffered-protocol\", \"method\": \"GET\", \"status\": 101, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": false}, {\"id\": \"W20\", \"family\": \"W\", \"name\": \"connection-token-case\", \"method\": \"GET\", \"status\": 101, \"mime\": \"\", \"body\": \"\", \"decoded_bytes\": 0, \"decoded_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"wire_base64\": \"\", \"tls\": true}];const TLS_URL=\"https://127.0.0.1:62282\";\nconst results=[];\nasync function run(c) {\n const url=(c.tls?TLS_URL:location.origin)+'/case/'+c.id+(c.query?'?'+c.query:'');\n const r={id:c.id,family:c.family};\n try {\n  if(c.family==='W') {\n   await new Promise(resolve=>{\n    const protocols=c.name==='subprotocol-chat'?['chat']:c.name==='graphql-transport-ws'?['graphql-transport-ws']:undefined;\n    const w=new WebSocket(url.replace(/^http/,'ws'),protocols);\n    w.binaryType='arraybuffer'; r.messages=[];\n    const timer=setTimeout(()=>{r.watchdog=true;w.close();resolve()},8000);\n    w.onopen=()=>{r.open=true;if(c.name==='graphql-transport-ws')w.send(JSON.stringify({type:'connection_init'}));};\n    w.onmessage=e=>{r.messages.push(typeof e.data==='string'?e.data:Array.from(new Uint8Array(e.data)));if(r.messages.length===(c.name==='two-messages'?2:1))w.close();};\n    w.onerror=()=>{r.error=true};\n    w.onclose=e=>{r.close=e.code;clearTimeout(timer);resolve()};\n   });\n  } else if(c.family==='S') {\n   await new Promise(resolve=>{\n    const stream=new EventSource(url);r.events=[];\n    const timer=setTimeout(()=>{r.watchdog=true;stream.close();resolve()},8000);\n    function event(e){r.events.push({type:e.type,data:e.data,id:e.lastEventId})}\n    for(const type of ['message','added','done','update'])stream.addEventListener(type,event);\n    stream.onerror=()=>{r.ended=true;stream.close();clearTimeout(timer);resolve()};\n   });\n  } else {\n   const options={method:c.method,redirect:c.follow?'follow':'manual',headers:{}};\n   if(c.request!==undefined) {options.body=c.request;options.headers['Content-Type']=c.request_mime||'text/plain'}\n   if(c.header)options.headers[c.header]='synthetic';\n   const response=await fetch(url,options);\n   const data=new Uint8Array(await response.arrayBuffer());\n   r.status=response.status;r.type=response.type;r.bytes=data.length;\n   r.sha256=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',data))).map(b=>b.toString(16).padStart(2,'0')).join('');\n  }\n }catch(e){r.error=String(e)}\n results.push(r);\n}\nsetTimeout(async()=>{for(const c of CASES)await run(c);window.campaignResults=results;document.title='Netscope capture complete'},1000);\n</script>"
